<div id="<%= dom_id hotel %>">
  <p>
    <strong>City:</strong>
    <%= hotel.city %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= hotel.name %>
  </p>

  <p>
    <strong>Category:</strong>
    <%= hotel.category %>
  </p>

  <p>
    <strong>Distance:</strong>
    <%= hotel.distance %>
  </p>

  <p>
    <strong>Agency:</strong>
    <%= hotel.agency %>
  </p>

  <p>
    <strong>Agency contact:</strong>
    <%= hotel.agency_contact %>
  </p>

</div>
