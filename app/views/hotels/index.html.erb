<%# app/views/hotels/index.html.erb %>
<p class="text-green-600"><%= notice %></p>
<% content_for :title, "Hotels" %>
<div data-controller="hotels" data-hotels-rate-value="<%= t('exchange_rate') %>">
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Hotels</h1>
  <%= link_to "New Hotel", new_hotel_path, 
              class: "text-green-600 hover:text-green-900 mr-4 px-4 py-2 bg-green-100 rounded m-4",
              data: { turbo_frame: "hotel_form" } %>
</div>

<%# Turbo Frame for the form (appears above table) %>
<turbo-frame id="hotel_form" class="block mb-8">
  <%# Form will appear here when "New Hotel" or "Edit" is clicked %>
</turbo-frame>

<div class="overflow-x-auto rounded-lg shadow">
  <table class="min-w-full bg-white divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">City</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Distance</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agency</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Types & Pricing</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100" id="hotels">
      <% @hotels.each do |hotel| %>
        <turbo-frame id="<%= dom_id(hotel) %>">
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-900"><%= hotel.name %></td>
            <td class="px-6 py-4 whitespace-nowrap"><%= hotel.city.titleize %></td>
            <td class="px-6 py-4 whitespace-nowrap"><%= hotel.category.titleize %></td>
            <td class="px-6 py-4 whitespace-nowrap"><%= hotel.distance %></td>
            <td class="px-6 py-4 whitespace-nowrap"><%= hotel.location %></td>
            <td class="px-6 py-4 whitespace-nowrap"><%= hotel.agency %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <ul>
                <% hotel.hotel_rooms.each do |hr| %>
                  <li>
                    <span class="font-medium"><%= hr.room_type&.name %></span>
                    <span class="ml-2 text-gray-500">SAR <%= hr.base_price %></span>
                    <span class="ml-2 text-gray-800">PKR <%= hr.base_price * t("exchange_rate") %></span>

                  </li>
                <% end %>
              </ul>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
              <%= link_to "Show", hotel, class: "text-blue-600 hover:text-blue-900 mr-2" %>
              <%= link_to "Edit", edit_hotel_path(hotel), 
                          class: "text-yellow-600 hover:text-yellow-900 mr-2", 
                          data: { turbo_frame: "hotel_form" } %>
              <%= link_to "Delete", hotel, 
                          method: :delete, 
                          class: "text-red-600 hover:text-red-900",
                          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
            </td>
          </tr>
        </turbo-frame>
      <% end %>
    </tbody>
  </table>
</div>