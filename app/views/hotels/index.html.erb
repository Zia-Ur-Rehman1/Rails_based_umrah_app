<%# Notice and Title %>
<p class="text-green-600"><%= notice %></p>
<% content_for :title, "Hotels" %>

<h1 class="text-2xl font-bold mb-6">Hotels</h1>



<div class="overflow-x-auto rounded-lg shadow">
  <table class="min-w-full bg-white divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">City</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Distance</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agency</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room Types & Pricing</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @hotels.each do |hotel| %>
        <tr class="hover:bg-gray-50 transition">
          <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-900"><%= hotel.name %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= hotel.city.titleize %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= hotel.category.titleize %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= hotel.distance %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= hotel.agency %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <ul>
              <% hotel.hotel_rooms.each do |hr| %>
                <li>
                  <span class="font-medium"><%= hr.room_type&.name %></span>
                  <span class="ml-2 text-gray-500">SAR <%= hr.base_price %></span>
                </li>
              <% end %>
            </ul>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <%= link_to "Show", hotel, class: "text-blue-600 hover:text-blue-900 mr-2" %>
            <%= link_to "Edit", edit_hotel_path(hotel), class: "text-yellow-600 hover:text-yellow-900 mr-2", data: { turbo_frame: "hotel_form" } %>
            <%= link_to "Delete", hotel, method: :delete, data: { confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>