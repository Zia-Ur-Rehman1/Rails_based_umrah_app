<tr id="<%= dom_id flight %>" class="hover:bg-gray-50">
  <td class="px-6 py-4 whitespace-nowrap">
    <%= flight.airline %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= flight.flight_number %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= flight.departure_airport %> → <%= flight.arrival_airport %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= pretty_flight_time(flight.departure_time) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= pretty_flight_time(flight.arrival_time) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= luggage_icon(flight.luggage) %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= flight.seats %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap">
    <%= flight.agency %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
    <%= link_to "Show", flight, class: "text-blue-600 hover:text-blue-900 mr-2" %>
    <%= link_to "Edit", edit_flight_path(flight),
                class: "text-yellow-600 hover:text-yellow-900 mr-2",
                data: { turbo_frame: "flight_form" } %>
    <%= link_to "Delete", flight,
                method: :delete,
                data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                class: "text-red-600 hover:text-red-900" %>
  </td>
</tr>