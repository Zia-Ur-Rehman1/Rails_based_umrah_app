<p class="text-green-600"><%= notice %></p>
<% content_for :title, "Editing post" %>

<h1 class="text-2xl font-bold mb-6">Editing post</h1>

<%= render "form", post: @post %>

<div class="mt-6 flex gap-4">
  <%= link_to "Show this post", @post,
              class: "text-blue-600 hover:text-blue-900 underline" %>
  <%= link_to "Back to posts", posts_path,
              class: "text-gray-600 hover:text-gray-900 underline" %>
</div>
