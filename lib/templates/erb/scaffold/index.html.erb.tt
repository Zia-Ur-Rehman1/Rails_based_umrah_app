<p class="text-green-600"><%%= notice %></p>
<%% content_for :title, "<%= human_name.pluralize %>" %>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold"><%= human_name.pluralize %></h1>
  <%%= link_to "New <%= human_name %>", <%= new_helper(type: :path) %>,
              class: "text-green-600 hover:text-green-900 mr-4 px-4 py-2 bg-green-100 rounded m-4",
              data: { turbo_frame: "<%= singular_table_name %>_form" } %>
</div>

<turbo-frame id="<%= singular_table_name %>_form" class="block mb-8"></turbo-frame>

<div class="overflow-x-auto rounded-lg shadow">
  <table class="min-w-full bg-white divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <% attributes.each do |attr| -%>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= attr.human_name %></th>
        <% end -%>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100" id="<%= plural_table_name %>">
      <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
        <%%= render <%= singular_table_name %> %>
      <%% end %>
    </tbody>
  </table>
</div>
