<p class="text-green-600"><%%= notice %></p>
<%% content_for :title, "Editing <%= human_name.downcase %>" %>

<h1 class="text-2xl font-bold mb-6">Editing <%= human_name.downcase %></h1>

<%%= render "form", <%= singular_table_name %>: @<%= singular_table_name %> %>

<div class="mt-6 flex gap-4">
  <%%= link_to "Show this <%= human_name.downcase %>", @<%= model_resource_name(singular_table_name) %>,
              class: "text-blue-600 hover:text-blue-900 underline" %>
  <%%= link_to "Back to <%= human_name.pluralize.downcase %>", <%= index_helper(type: :path) %>,
              class: "text-gray-600 hover:text-gray-900 underline" %>
</div>
