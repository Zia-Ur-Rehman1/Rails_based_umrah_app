<% module_namespacing do -%>
class <%= controller_class_name %>Controller < ApplicationController
  before_action :set_<%= singular_table_name %>, only: %i[ show edit update destroy ]

  def index
    @<%= plural_table_name %> = <%= orm_class.all(class_name) %>
  end

  def show
  end

  def new
    @<%= singular_table_name %> = <%= orm_class.build(class_name) %>
  end

  def edit
  end

  def create
    @<%= singular_table_name %> = <%= orm_class.build(class_name, "#{singular_table_name}_params") %>

    if @<%= orm_instance.save %>
      flash[:notice] = "<%= human_name %> was successfully created."
      respond_to do |format|
        format.turbo_stream do
          render turbo_stream: [
            turbo_stream.append("<%= plural_table_name %>", partial: "<%= plural_table_name %>/<%= singular_table_name %>", locals: { <%= singular_table_name %>: @<%= singular_table_name %> }),
            turbo_stream.replace("<%= singular_table_name %>_form", partial: "<%= plural_table_name %>/form", locals: { <%= singular_table_name %>: <%= orm_class.build(class_name) %> }),
            turbo_stream.replace("flash", partial: "shared/flash")
          ]
        end
        format.html { redirect_to <%= redirect_resource_name %>, notice: flash[:notice] }
      end
    else
      flash[:alert] = @<%= singular_table_name %>.errors.full_messages.to_sentence
      respond_to do |format|
        format.turbo_stream do
          render turbo_stream: [
            turbo_stream.replace("<%= singular_table_name %>_form", partial: "<%= plural_table_name %>/form", locals: { <%= singular_table_name %>: @<%= singular_table_name %> }),
            turbo_stream.replace("flash", partial: "shared/flash")
          ]
        end
        format.html { render :new, status: :unprocessable_entity }
      end
    end
  end

  def update
    if @<%= orm_instance.update("#{singular_table_name}_params") %>
      flash[:notice] = "<%= human_name %> was successfully updated."
      respond_to do |format|
        format.turbo_stream do
          render turbo_stream: [
            turbo_stream.replace("<%= singular_table_name %>_#{@<%= singular_table_name %>.id}", partial: "<%= plural_table_name %>/<%= singular_table_name %>", locals: { <%= singular_table_name %>: @<%= singular_table_name %> }),
            turbo_stream.replace("flash", partial: "shared/flash")
          ]
        end
        format.html { redirect_to <%= redirect_resource_name %>, notice: flash[:notice] }
      end
    else
      flash[:alert] = @<%= singular_table_name %>.errors.full_messages.to_sentence
      respond_to do |format|
        format.turbo_stream do
          render turbo_stream: [
            turbo_stream.replace("<%= singular_table_name %>_form", partial: "<%= plural_table_name %>/form", locals: { <%= singular_table_name %>: @<%= singular_table_name %> }),
            turbo_stream.replace("flash", partial: "shared/flash")
          ]
        end
        format.html { render :edit, status: :unprocessable_entity }
      end
    end
  end

  def destroy
    @<%= orm_instance.destroy %>
    flash[:notice] = "<%= human_name %> was successfully destroyed."
    respond_to do |format|
      format.turbo_stream do
        render turbo_stream: [
          turbo_stream.remove("<%= singular_table_name %>_#{@<%= singular_table_name %>.id}"),
          turbo_stream.replace("flash", partial: "shared/flash")
        ]
      end
      format.html { redirect_to <%= index_helper %>_path, notice: flash[:notice] }
    end
  end

  private

    def set_<%= singular_table_name %>
      @<%= singular_table_name %> = <%= orm_class.find(class_name, "params[:id]") %>
    end

    def <%= "#{singular_table_name}_params" %>
      <%- if attributes_names.empty? -%>
      params.fetch(:<%= singular_table_name %>, {})
      <%- else -%>
      params.require(:<%= singular_table_name %>).permit(<%= permitted_params %>)
      <%- end -%>
    end
end
<% end -%>
