require "test_helper"

class <%= controller_class_name %>Test < ActionDispatch::IntegrationTest
  setup do
    @<%= singular_table_name %> = <%= table_name %>(:one)
  end

  test "should get index" do
    get <%= index_helper %>_url
    assert_response :success
  end

  test "should get new" do
    get new_<%= singular_table_name %>_url
    assert_response :success
  end

  test "should create <%= singular_table_name %> with turbo stream" do
    assert_difference("<%= class_name %>.count") do
      post <%= index_helper %>_url,
           params: { <%= singular_table_name %>: {
             <%- attributes_hash = attributes_names.map { |name| "#{name}: @#{singular_table_name}.#{name}" }.join(', ') -%>
             <%= attributes_hash %>
           } },
           as: :turbo_stream
    end

    assert_response :success
    assert_turbo_stream action: "append", target: "<%= plural_table_name %>"
    assert_turbo_stream action: "replace", target: "<%= singular_table_name %>_form"
  end

  test "should show <%= singular_table_name %>" do
    get <%= singular_table_name %>_url(@<%= singular_table_name %>)
    assert_response :success
  end

  test "should get edit" do
    get edit_<%= singular_table_name %>_url(@<%= singular_table_name %>)
    assert_response :success
  end

  test "should update <%= singular_table_name %> with turbo stream" do
    patch <%= singular_table_name %>_url(@<%= singular_table_name %>),
          params: { <%= singular_table_name %>: {
            <%- attributes_hash = attributes_names.map { |name| "#{name}: @#{singular_table_name}.#{name}" }.join(', ') -%>
            <%= attributes_hash %>
          } },
          as: :turbo_stream

    assert_response :success
    assert_turbo_stream action: "replace", target: dom_id(@<%= singular_table_name %>)
  end

  test "should destroy <%= singular_table_name %> with turbo stream" do
    assert_difference("<%= class_name %>.count", -1) do
      delete <%= singular_table_name %>_url(@<%= singular_table_name %>), as: :turbo_stream
    end

    assert_response :success
    assert_turbo_stream action: "remove", target: dom_id(@<%= singular_table_name %>)
  end
end
